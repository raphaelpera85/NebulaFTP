# ==============================================
# NEBULA FTP - CONFIGURAÇÃO
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ==============================================

# ============= TELEGRAM =============
# Obtenha em: https://my.telegram.org
API_ID=12345678
API_HASH=abc123def456789...

# Crie bots em: https://t.me/BotFather
# Para múltiplos bots, separe por vírgula
BOT_TOKENS=replace_with_bot_tokens_separated_by_commas

# ID do canal principal (copie de @userinfobot)
# Formato: -100XXXXXXXXXX
CHAT_ID=-1001234567890

# Canal de backup (opcional)
BACKUP_CHAT_ID=-1009876543210

# ============= MONGODB =============
# MongoDB Atlas (cloud): mongodb+srv://user:pass@cluster.mongodb.net/ftp
# MongoDB Local: mongodb://localhost:27017
MONGODB=mongodb://localhost:27017
MONGO_DATABASE=ftp

# ============= SERVIDOR FTP =============
HOST=0.0.0.0
PORT=2121

# Portas passivas (range para conexões de dados)
# Formato: inicio-fim. Default: 10 portas (60000-60009).
PASSIVE_PORTS=60000-60009

# ============= TLS / FTPS (RFC 4217) =============
# To enable FTPS, set BOTH files and switch FTP_SECURITY_MODE below.
# Generate cert with: openssl req -x509 -newkey rsa:2048 -nodes \
#   -keyout nebula.key -out nebula.crt -days 365 \
#   -subj "/CN=your.host"
# Leave blank to disable FTPS (DO NOT do this on any public network).
TLS_CERTFILE=
TLS_KEYFILE=
# Set true to require client certificates (mutual TLS).
TLS_REQUIRE_CLIENT_CERT=false
TLS_REQUIRED=false
# ftp, ftps-explicit (AUTH TLS), or ftps-implicit.
# TLS files with mode=ftp are rejected instead of silently using plaintext.
FTP_SECURITY_MODE=ftp

# ============= MulletaFlix control plane =============
# Disabled unless explicitly enabled. Use at least 32 random characters.
CONTROL_ENABLED=false
CONTROL_HOST=127.0.0.1
CONTROL_PORT=2130
CONTROL_TOKEN=
CONTROL_DRAIN_TIMEOUT=300

# Feeder paths are explicit allowlists. Separate multiple roots with `;` on
# Windows and `:` on Linux. The plugin may only start jobs inside these roots.
FEED_ALLOWED_ROOTS=D:\Media
FEED_ALLOWED_DESTINATIONS=D:\Media
FEED_STATE_DIR=state
FEED_STOP_TIMEOUT=15
NEBULA_LIBRARY_USER=raphael

# STRM output is constrained to this root allowlist.
STRM_OUTPUT_DIR=strm_library
STRM_OUTPUT_ROOTS=strm_library
PRUNE_PREVIEW_TTL=300

# ============= HTTP STREAM =============
STREAM_ONLY=false
STREAM_HOST=127.0.0.1
STREAM_PORT=2122
# Required with at least 32 random characters when STREAM_HOST is non-loopback.
STREAM_TOKEN=
# Maximum simultaneous FFmpeg transcodes.
TRANSCODE_CONCURRENCY=2

# ============= SEGURANÇA =============
# bcrypt cost factor for password hashing (12 = ~250 ms on modern CPUs).
BCRYPT_ROUNDS=12

# ============= PERFORMANCE =============
# Máximo de arquivos ativos. Não é a quantidade de requisições ao Telegram.
MAX_WORKERS=28

# Limite global adaptativo de requisições/partes em voo ao Telegram.
# Em FloodWait/429/timeouts ele reduz e volta a crescer após sucessos.
UPLOAD_CONCURRENCY=24
UPLOAD_CONCURRENCY_MIN=4
UPLOAD_CONCURRENCY_MAX=24
UPLOAD_CONCURRENCY_START=20
UPLOAD_METRICS_INTERVAL=15

# Tamanho dos chunks em MB (16MB)
CHUNK_SIZE_MB=16

# Partes paralelas por arquivo. Comece em 1 para distribuir até 28 arquivos
# pela pool inteira; aumente apenas após benchmark controlado.
PART_WORKERS_PER_FILE=1

# Tentativas de retry em caso de erro
MAX_RETRIES=5

# Tempo máximo de staging em segundos (1 hora)
MAX_STAGING_AGE=3600
# Varredura de recuperação das pastas de stage (segundos; mínimo 5).
# O percurso ocorre fora do event loop para não atrasar operações FTP.
STAGE_SCAN_INTERVAL=30

# Cache de reprodução em NebulaFTP-master/media-cache por padrão, fora do staging.
# Defina MEDIA_CACHE_DIR para usar outro local. A reprodução começa pelo Telegram;
# o pré-carregamento em segundo plano é cancelado quando o último leitor fecha.
MEDIA_CACHE_DIR=
MEDIA_CACHE_TTL_SECONDS=900
MEDIA_CACHE_MAX_GB=100

# Intervalo do Garbage Collector em segundos (padrão: 60)
GC_INTERVAL_SECONDS=60

# Cache LRU do pathio (entradas) — evita leak de memória em processos longos.
PATHIO_CACHE_MAXSIZE=10000

# ============= LOGGING =============
# Níveis: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============= AVANÇADO (OPCIONAL) =============
# Tamanho máximo do log em MB
LOG_MAX_SIZE=5

# Número de arquivos de log para manter
LOG_BACKUP_COUNT=3
